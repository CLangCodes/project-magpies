@using ProjectMagpie.Database
@using ProjectMagpie.Models
@rendermode InteractiveServer
@inject ISnackbar Snackbar
@inject IRepository<Thing> ThingRepository
@inject IWebHostEnvironment Env
@inject IHttpClientFactory Http
<MudDialog>
    <DialogContent>
        <MudCard>
            <MudCardContent Style="display: flex; flex-direction: row; gap: 16px;">
                <MudElement Style="flex: 0 0 200px;">
                    @if (!string.IsNullOrEmpty(_previewUrl) || !string.IsNullOrEmpty(Thing?.ImageUrl))
                    {
                        <MudCardMedia Image="@(_previewUrl ?? _imageUrl)" Style="width: 200px; height: 200px; object-fit: cover; border-radius: 4px;" />
                    }
                    else
                    {
                        <MudPaper Outlined="true" Style="width: 200px; height: 200px; display: flex; align-items: center; justify-content: center;">
                            <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Large" Color="Color.Default" />
                        </MudPaper>
                    }
                </MudElement>
                <MudElement Style="flex: 1 1 auto;">
                    <MudTextField @bind-Value="_name" Label="Name" Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true" />
                    <MudTextField @bind-Value="_description" Label="Description" Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true" />
                    <MudDivider />
                    <MudNumericField @bind-Value="_cost" Label="Cost" Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true" />
                    <MudNumericField @bind-Value="_restorationCost" Label="Restoration Cost" Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true" />
                    <MudNumericField @bind-Value="_soldFor" Label="Sold For" Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true" />
                </MudElement>
            </MudCardContent>
            <MudCardActions>
                <MudFileUpload T="IBrowserFile" FilesChanged="OnFilesChanged" Accept=".png,.jpg,.jpeg,.gif" />
                @if (!string.IsNullOrEmpty(_imageUrl))
                {
                    <MudButton Color="Color.Error" Variant="Variant.Outlined" OnClick="RemovePicture">Remove Picture</MudButton>
                }
            </MudCardActions>
        </MudCard>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Submit</MudButton>
        <MudButton Color="Color.Secondary" Variant="Variant.Outlined" OnClick="Cancel">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public Thing? Thing { get; set; }

    private string _name = string.Empty;
    private decimal _cost = 0;
    private decimal? _restorationCost = 0;
    private decimal? _soldFor = 0;
    private string _description = string.Empty;
    private string? _imageUrl;
    private IBrowserFile? _pictureFile;
    private IBrowserFile? _fileUpload;
    private string? _previewUrl;
    private bool _swapping = false;
    private string _base64 = string.Empty;

    protected override void OnParametersSet()
    {
        if (Thing != null)
        {
            _name = Thing.Name;
            _cost = Thing.Cost;
            _restorationCost = Thing.RestorationCost;
            _soldFor = Thing.SoldFor;
            _description = Thing.Description;
            _imageUrl = Thing.ImageUrl;
        } else {
            Thing = new Thing();
        }
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        _imageUrl = Thing?.ImageUrl;
        if (!string.IsNullOrEmpty(_imageUrl))
        {
            _base64 = await ConvertImageToBase64(_imageUrl);
        }
        StateHasChanged();
    }

    private async Task OnFilesChanged(IBrowserFile file)
    {
        _fileUpload = file;
        if (string.IsNullOrEmpty(file.Name))
        {
            _previewUrl = null;
            StateHasChanged();
            return;
        }
        using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        _previewUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
        StateHasChanged();
    }

    private async Task Submit()
    {
        if (Thing != null)
        {
            Thing.Name = _name;
            Thing.Cost = _cost;
            Thing.RestorationCost = _restorationCost;
            Thing.SoldFor = _soldFor;
            Thing.Description = _description;
            Thing.ImageUrl = _imageUrl;

            bool isNew = Thing.Id == 0;
            if (isNew)
                await ThingRepository.AddAsync(Thing);
            else
                await ThingRepository.UpdateAsync(Thing);

            if (_fileUpload != null && _fileUpload.GetHashCode() != _pictureFile?.GetHashCode())
            {
                if (!string.IsNullOrEmpty(Thing.ImageUrl))
                {
                    var oldPath = Path.Combine(Env.WebRootPath, Thing.ImageUrl);
                    if (File.Exists(oldPath))
                        File.Delete(oldPath);
                }

                var ext = Path.GetExtension(_fileUpload.Name);
                var fileName = $"{Thing.Id}_{DateTime.UtcNow.Ticks}{ext}";
                var folder = Path.Combine(Env.WebRootPath, "ThingImages");
                Directory.CreateDirectory(folder);
                var path = Path.Combine(folder, fileName);

                await using var stream = File.Create(path);
                await _fileUpload.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(stream);

                Thing.SetImageUrl(fileName);
                await ThingRepository.UpdateAsync(Thing);
            }
            StateHasChanged();
        }

        MudDialog.Close(DialogResult.Ok(Thing));
    }

    private async Task<string> ConvertImageToBase64(string filePath)
    {
        try
        {
            // Remove leading wwwroot/ if present, as static files are served from root
            var relativePath = filePath.StartsWith("wwwroot/") ? filePath.Substring(7) : filePath;
            using HttpClient client = Http.CreateClient();
            var response = await client.GetAsync(relativePath);
            if (!response.IsSuccessStatusCode)
                return string.Empty;
            var imageBytes = await response.Content.ReadAsByteArrayAsync();
            // Try to get content type from response, fallback to jpeg
            var contentType = response.Content.Headers.ContentType?.MediaType ?? "image/jpeg";
            return $"data:{contentType};base64,{Convert.ToBase64String(imageBytes)}";
        }
        catch
        {
            return string.Empty;
        }
    }

    private async Task RemovePicture()
    {
        if (!string.IsNullOrEmpty(_imageUrl))
        {
            @* var oldPath = Path.Combine(Env.WebRootPath, Thing.ImageUrl);
            if (File.Exists(oldPath))
                File.Delete(oldPath); *@

            @* Thing.SetImageUrl(null); *@
            @* await ThingRepository.UpdateAsync(Thing); *@
            _imageUrl = null;
            @* _base64 = string.Empty; *@
            @* Snackbar.Add("Image removed successfully!", Severity.Success); *@
            StateHasChanged();
        }
    }

    private void Cancel() => MudDialog.Cancel();
}